---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'festivos-municipio', h2: 'Holiday search by town', text: 'Type a Spanish town: it shows the year\'s holidays with their scope, the next holiday, the working days and an .ics calendar file.', t: 'Public holidays in your Spanish town, 2027', h: 1100 },
  { name: 'puentes', h2: 'Long-weekend planner', text: 'Places your leave days where they give the most days off in a row, with the region\'s or the town\'s holidays.', t: 'Spain long weekends planner 2027', h: 1000 },
];
---
<PageLayout title="Embed the Spain 2027 holiday search on your site for free" description="Embed for free with an iframe the Spanish holiday search by town and the 2027 long-weekend planner: dates update by themselves whenever a new gazette is published." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the tools</h1>
    <p class="mt-1 text-xs font-medium uppercase tracking-wide text-navy-500">Independent, non-governmental site</p>
    <p class="mt-3 text-lg text-navy-700">For councils, associations, works councils and media: copy it once and new dates appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the Spanish version, change <code>/embed/en/</code> to <code>/embed/es/</code>. Terms: the source link under the tool stays visible, the tool is not altered and comes without warranty. What your readers type stays on their device. Questions on the <a href={route('contact', lang)}>contact</a> page.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/festivos-municipio/`} title="Public holidays in your Spanish town, 2027" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
